# =============================================================================
# StrangeVerse — perfiles de ejemplo (copiar a .env y rellenar secretos)
# Documentacion: docs/CONFIGURACION_LLM_LOCAL.md
# =============================================================================

# --- Siempre necesario para arrancar el backend (ver doc Zep) ---
# ZEP_API_KEY=your_zep_api_key_here

# =============================================================================
# Perfil A — Ollama local (Gemma, Qwen local, etc.)
# Requisito: ollama serve y modelo descargado (ollama list)
# =============================================================================
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_NAME=gemma3:4b

# =============================================================================
# Perfil B — Qwen en la nube (Alibaba Dashscope)
# =============================================================================
# LLM_API_KEY=your_dashscope_api_key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# =============================================================================
# Perfil C — Principal + LLM_BOOST (simulacion paralela en scripts)
# Solo rellena LLM_BOOST_* si quieres un segundo proveedor para paralelismo.
# Si no usas boost, no descomentes estas lineas.
# =============================================================================
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_NAME=gemma3:4b
#
# LLM_BOOST_API_KEY=your_dashscope_api_key
# LLM_BOOST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BOOST_MODEL_NAME=qwen-plus

# =============================================================================
# Opcional: limitar rondas OASIS por defecto (entero)
# =============================================================================
# OASIS_DEFAULT_MAX_ROUNDS=10
